#!/usr/bin/env bash
# Share videos on jackafur.com. In Dolphin: right-click a video, "jackafur.com", then Share / Copy link / Take down.
#   Share:     makes web copies, uploads them to https://jackafur.com/v/<id>/, puts the link on the clipboard, and moves
#              the video into ~/Videos/OBS/Shared. What is in that folder is what is online.
#   Copy link: the link of a shared video, on the clipboard.
#   Take down: off the website, and the video moves back to the folder it came from. Nothing is deleted from the PC.
# Web copies: an HDR clip (PQ) gets AV1 HDR (Chrome, Edge, Firefox, Discord) + HEVC HDR (Safari, iPhone) for HDR screens and
# an H.264 SDR one, tone-mapped (SDR screens, Discord's preview); the page has an HDR / SDR button. A normal video: H.264 only.
# Anyone with the link can watch; nothing lists them; search engines told to stay out (noindex).
# Terminal: vshare <file>... | vshare link <file>... | vshare down <file>... | vshare list | vshare rm <id>
# Upload login: the SSH host alias in HOST below (an account that can write the web root is enough). Log: ~/.local/share/vshare/shared.tsv (id, date,
# name, the folder it came from); each shared file also carries its id (xattr user.vshare.id).
# Service menu: ~/.local/share/kio/servicemenus/vshare.desktop. Notes: notebook Projects/Linux PC/CachyOS setup.md, Recording.
set -uo pipefail
HOST=vps-claude
WEBROOT=/var/www/jackafur/v
SITE=https://jackafur.com/v
SHARED="$HOME/Videos/OBS/Shared"
LOG="$HOME/.local/share/vshare/shared.tsv"
WORK="$HOME/.cache/vshare"
mkdir -p "$(dirname "$LOG")" "$WORK" "$SHARED"
touch "$LOG"

say() { notify-send -a "Share" -i video-x-generic "$@"; }

# The id of a shared file: its tag, else its name in the log (a file in Shared that lost its tag).
idOf() {
    local f=$1 id
    id=$(getfattr -n user.vshare.id --only-values "$f" 2>/dev/null)
    [[ -z $id && $(cd "$(dirname "$f")" && pwd) == "$SHARED" ]] && id=$(awk -F'\t' -v n="$(basename "$f")" '$3 == n { print $1 }' "$LOG" | tail -1)
    [[ -n $id ]] && grep -q "^$id"$'\t' "$LOG" && echo "$id"
}
# A free name for $2 in folder $1 (adds " (2)", " (3)"...).
freeName() {
    local d=$1 n=$2 b e i=2
    [[ ! -e $d/$n ]] && { echo "$d/$n"; return; }
    b=${n%.*}; e=${n##*.}
    while [[ -e "$d/$b ($i).$e" ]]; do i=$((i + 1)); done
    echo "$d/$b ($i).$e"
}
takeDown() { # $1 id, $2 the shared file (may be empty)
    local id=$1 f=${2:-} from back
    ssh "$HOST" "rm -rf '$WEBROOT/$id'" || { say "Couldn't take it down" "The VPS didn't answer. Nothing changed."; return 1; }
    from=$(awk -F'\t' -v i="$id" '$1 == i { print $4 }' "$LOG" | tail -1)
    sed -i "/^$id"$'\t'"/d" "$LOG"
    if [[ -n $f && -e $f ]]; then
        setfattr -x user.vshare.id "$f" 2>/dev/null
        [[ -n $from ]] || from="$HOME/Videos/OBS"
        mkdir -p "$from"
        back=$(freeName "$from" "$(basename "$f")")
        mv "$f" "$back"
        say "Taken down: $(basename "$f")" "Off jackafur.com. The video is back in $from"
    else
        say "Taken down" "$SITE/$id/ is gone"
    fi
}

case "${1:-}" in
list)
    [[ -s $LOG ]] && column -t -s $'\t' "$LOG" || echo "Nothing shared yet."
    exit 0 ;;
link)
    shift; links=""
    for f in "$@"; do
        id=$(idOf "$f") || { say "Not shared: $(basename "$f")" "Right-click, jackafur.com, Share to put it online."; continue; }
        links+="$SITE/$id/"$'\n'
    done
    [[ -n $links ]] && { printf '%s' "${links%$'\n'}" | wl-copy >/dev/null 2>&1; say -t 6000 "Link copied" "${links%$'\n'}"; }
    exit 0 ;;
down)
    shift
    for f in "$@"; do
        id=$(idOf "$f") || { say "Not shared: $(basename "$f")" "It isn't on jackafur.com."; continue; }
        takeDown "$id" "$f"
    done
    exit 0 ;;
rm)
    id=${2:-}
    [[ $id =~ ^[a-zA-Z0-9]{8}$ ]] || { echo "usage: vshare rm <id> (the 8 letters after /v/)"; exit 1; }
    f=""
    for g in "$SHARED"/*; do [[ -e $g && $(getfattr -n user.vshare.id --only-values "$g" 2>/dev/null) == "$id" ]] && f=$g; done
    if [[ -z $f ]]; then
        n=$(awk -F'\t' -v i="$id" '$1 == i { print $3 }' "$LOG" | tail -1)
        [[ -n $n && -e $SHARED/$n ]] && f="$SHARED/$n"
    fi
    takeDown "$id" "$f" && echo "Taken down: $SITE/$id/"
    exit $? ;;
share)
    shift ;;
""|-h|--help)
    sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac

html_escape() { sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g'; }
vlevel() { ffprobe -v error -select_streams v:0 -show_entries stream=level -of csv=p=0 "$1" | tr -dc 0-9; }
VAAPI=(-hwaccel vaapi -hwaccel_device /dev/dri/renderD128 -hwaccel_output_format vaapi)
PQ=(-color_primaries bt2020 -color_trc smpte2084 -colorspace bt2020nc)
AUDIO=(-c:a aac -b:a 160k -movflags +faststart)

share() {
    local f=$1 name id dir title hdr w h sources="" from dest
    name=$(basename "$f")
    if [[ -z ${VSHARE_ID:-} ]] && id=$(idOf "$f"); then
        printf '%s/%s/' "$SITE" "$id" | wl-copy >/dev/null 2>&1
        say -t 8000 "Already shared: $name" "$SITE/$id/  (on your clipboard)"
        return 0
    fi
    id=${VSHARE_ID:-$(tr -dc 'a-zA-Z0-9' </dev/urandom | head -c 8)}  # (VSHARE_ID=<id>: redo a page at the same link)
    dir="$WORK/$id"
    mkdir -p "$dir"
    hdr=$(ffprobe -v error -select_streams v:0 -show_entries stream=color_transfer -of default=nw=1:nk=1 "$f")
    IFS=x read -r w h < <(ffprobe -v error -select_streams v:0 -show_entries stream=width,height -of csv=s=x:p=0 "$f")
    say -t 4000 "Sharing $name" "Making the web copies, then uploading. The link lands on your clipboard."

    if [[ $hdr == smpte2084 ]]; then
        nice ffmpeg -v error -y "${VAAPI[@]}" -i "$f" -c:v av1_vaapi -rc_mode VBR -b:v 25M -maxrate 40M "${PQ[@]}" "${AUDIO[@]}" "$dir/hdr-av1.mp4" &&
        nice ffmpeg -v error -y "${VAAPI[@]}" -i "$f" -c:v hevc_vaapi -profile:v main10 -tag:v hvc1 -rc_mode VBR -b:v 32M -maxrate 50M "${PQ[@]}" "${AUDIO[@]}" "$dir/hdr-hevc.mp4" &&
        nice ffmpeg -v error -y -i "$f" \
            -vf "libplacebo=tonemapping=bt.2390:colorspace=bt709:color_primaries=bt709:color_trc=bt709:range=tv:format=yuv420p" \
            -c:v libx264 -preset faster -crf 18 -maxrate 35M -bufsize 70M "${AUDIO[@]}" "$dir/sdr.mp4" 2> >(grep -v 'radv is not a conformant' >&2) ||
            { say "Share failed: $name" "A copy didn't encode. Nothing was uploaded."; rm -rf "$dir"; return 1; }
        sources+="<source data-hdr media=\"(dynamic-range: high)\" src=\"hdr-av1.mp4\" type='video/mp4; codecs=\"$(printf 'av01.0.%02dM.10' "$(vlevel "$dir/hdr-av1.mp4")")\"'>"
        sources+="<source data-hdr media=\"(dynamic-range: high)\" src=\"hdr-hevc.mp4\" type='video/mp4; codecs=\"hvc1.2.4.L$(vlevel "$dir/hdr-hevc.mp4").B0\"'>"
    else
        nice ffmpeg -v error -y -i "$f" -vf "format=yuv420p" -c:v libx264 -preset faster -crf 18 -maxrate 35M -bufsize 70M "${AUDIO[@]}" "$dir/sdr.mp4" ||
            { say "Share failed: $name" "The copy didn't encode. Nothing was uploaded."; rm -rf "$dir"; return 1; }
    fi
    sources+="<source src=\"sdr.mp4\" type='video/mp4; codecs=\"$(printf 'avc1.6400%02x' "$(vlevel "$dir/sdr.mp4")")\"'>"
    ffmpeg -v error -y -ss 3 -i "$dir/sdr.mp4" -frames:v 1 -vf scale=1280:-2 -q:v 3 "$dir/thumb.jpg" 2>/dev/null ||
        ffmpeg -v error -y -i "$dir/sdr.mp4" -frames:v 1 -vf scale=1280:-2 -q:v 3 "$dir/thumb.jpg"

    title=$(printf '%s' "${name%.*}" | html_escape)
    cat >"$dir/index.html" <<EOF
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>$title</title>
<meta property="og:type" content="video.other">
<meta property="og:site_name" content="jackafur.com">
<meta property="og:title" content="$title">
<meta property="og:url" content="$SITE/$id/">
<meta property="og:image" content="$SITE/$id/thumb.jpg">
<meta property="og:video" content="$SITE/$id/sdr.mp4">
<meta property="og:video:secure_url" content="$SITE/$id/sdr.mp4">
<meta property="og:video:type" content="video/mp4">
<meta property="og:video:width" content="$w">
<meta property="og:video:height" content="$h">
<meta name="twitter:card" content="player">
<meta name="twitter:image" content="$SITE/$id/thumb.jpg">
<style>
  html, body { margin: 0; height: 100%; background: #000; color: #888; font: 14px system-ui, sans-serif; }
  body { display: flex; flex-direction: column; align-items: center; justify-content: center; }
  video { max-width: 100vw; max-height: calc(100vh - 2.5em); width: 100%; background: #000; }
  p { margin: .6em 16px; text-align: center; }
  a { color: #aaa; }
  button { font: inherit; color: #ddd; background: #222; border: 1px solid #444; border-radius: 4px; padding: .15em .6em; cursor: pointer; }
  button:hover { background: #333; }
</style>
</head>
<body>
<video controls playsinline preload="metadata" poster="thumb.jpg">$sources</video>
<p>$title · <button id="mode" hidden></button> <a href="sdr.mp4" download>download</a></p>
<script>
// HDR / SDR button: the page picks a copy by the screen when it loads; the button swaps to the other one and keeps your place.
(function () {
  var v = document.querySelector("video"), b = document.getElementById("mode");
  var sdr = v.querySelector("source:not([data-hdr])").src;
  var hdr = Array.prototype.find.call(v.querySelectorAll("source[data-hdr]"), function (s) { return v.canPlayType(s.type); });
  if (!hdr) return;
  function label() {
    var onHdr = v.currentSrc && v.currentSrc !== sdr;
    b.textContent = onHdr ? "HDR \u2192 switch to SDR" : "SDR \u2192 switch to HDR";
    b.hidden = !v.currentSrc;
  }
  v.addEventListener("loadedmetadata", label);
  label();
  b.addEventListener("click", function () {
    var t = v.currentTime, playing = !v.paused;
    v.src = v.currentSrc === sdr ? hdr.src : sdr;
    v.addEventListener("loadedmetadata", function () { v.currentTime = t; if (playing) v.play(); }, { once: true });
  });
})();
</script>
</body>
</html>
EOF
    if rsync -r --chmod=D755,F644 "$dir/" "$HOST:$WEBROOT/.$id.part/" &&
        ssh "$HOST" "rm -rf '$WEBROOT/$id' && mv '$WEBROOT/.$id.part' '$WEBROOT/$id'"; then
        printf '%s/%s/' "$SITE" "$id" | wl-copy >/dev/null 2>&1
        from=$(cd "$(dirname "$f")" && pwd)
        if [[ $from == "$SHARED" ]]; then
            dest=$f
            from=$(awk -F'\t' -v i="$id" '$1 == i { print $4 }' "$LOG" | tail -1)
            [[ -n $from ]] || from="$HOME/Videos/OBS"
        else
            dest=$(freeName "$SHARED" "$name")
            mv "$f" "$dest"
        fi
        setfattr -n user.vshare.id -v "$id" "$dest" 2>/dev/null
        sed -i "/^$id"$'\t'"/d" "$LOG"
        printf '%s\t%s\t%s\t%s\n' "$id" "$(date '+%F %R')" "$(basename "$dest")" "$from" >>"$LOG"
        rm -rf "$dir"
        say -t 15000 "Shared: $name" "$SITE/$id/  (on your clipboard). The video is in Videos/OBS/Shared now."
        echo "$SITE/$id/"
    else
        say "Upload failed: $name" "The copies are kept in $dir"
        ssh "$HOST" "rm -rf '$WEBROOT/.$id.part'" 2>/dev/null
        return 1
    fi
}

ssh "$HOST" "mkdir -p $WEBROOT" || { say "Share failed" "Couldn't reach the VPS."; exit 1; }
for f in "$@"; do share "$f"; done
