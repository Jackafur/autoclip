#!/usr/bin/env bash
# Right-click an HDR clip in Dolphin, "Make SDR copy": writes "<name> (SDR).mp4" beside it, H.264 8-bit,
# tone-mapped on the GPU (libplacebo), so Discord and phones show it right. The HDR original stays.
# Service menu: ~/.local/share/kio/servicemenus/sdr-copy.desktop.
for f in "$@"; do
    name=$(basename "$f")
    if [[ $(ffprobe -v error -select_streams v:0 -show_entries stream=color_transfer -of default=nw=1:nk=1 "$f") != smpte2084 ]]; then
        notify-send -a OBS -i com.obsproject.Studio "Already SDR: $name"; continue
    fi
    out="${f%.*} (SDR).mp4"
    notify-send -a OBS -i com.obsproject.Studio -t 2500 "Making SDR copy: $name"
    if nice ffmpeg -v error -y -i "$f" \
        -vf "libplacebo=tonemapping=bt.2390:colorspace=bt709:color_primaries=bt709:color_trc=bt709:range=tv:format=yuv420p" \
        -c:v libx264 -preset medium -crf 18 -c:a copy -movflags +faststart "$out"; then
        notify-send -a OBS -i com.obsproject.Studio "SDR copy done: $(basename "$out")"
    else
        notify-send -a OBS -i com.obsproject.Studio "SDR copy failed: $name"; rm -f "$out"
    fi
done
